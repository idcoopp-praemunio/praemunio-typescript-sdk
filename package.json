{
  "name": "@praemunio/sdk",
  "version": "1.0.4",
  "description": "OpenAPI client for Praemunio Typescript SDK",
  "author": "bonavJS <bonavjs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/idcoopp-praemunio/praemunio-typescript-sdk.git"
  },
  "keywords": [
